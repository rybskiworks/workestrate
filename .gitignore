# Plaintext dotenv files
.env
.env.*

# Local private keys / decrypted dumps
.keys/
*.agekey
age.txt
.secrets/

# Upstream agent repos and build outputs (gitignored — flake/local + build cache)
agents/*/repo
agents/*/build
agents/*/.build-hash

# nix build byproducts; GC roots; build with --no-link
result
result-*

target/
**/target/

.direnv/
.toolchain/

*.qcow2
*.img
*.log
core

__pycache__/
*.pyc

# Nix-generated patched crate (symlinked by nix develop)
control/agentctl/vendor/

# Temporary extraction / download cache
.tmp/


# Zed editor settings (IDE-specific, not project config)
.zed/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# devenv task/state/cache runtime dirs (flake.nix redirects these to
# $HOME/.cache/devenv/workestrate; the in-tree fallback stays ignored)
.devenv/
