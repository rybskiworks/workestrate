# Plaintext dotenv files
.env
.env.*

# Local private keys / decrypted dumps
.keys/
*.agekey
age.txt
.secrets/

var/*
!var/.gitkeep

workspaces/*
!workspaces/.gitkeep

# Upstream agent repos and build outputs (gitignored — flake/local + build cache)
agents/*/repo
agents/*/build
agents/*/.build-hash

result
result-*

target/
**/target/

.direnv/
.toolchain/

*.qcow2
*.img
*.log
core

__pycache__/
*.pyc

# Nix-generated patched crate (symlinked by nix develop)
control/agentctl/vendor/

# Temporary extraction / download cache
.tmp/

# Repo-local workestrate XDG state (contains age private key — NEVER commit)
/.workestrate/
