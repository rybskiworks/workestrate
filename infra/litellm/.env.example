# Example environment file. Copy to .env and fill in real values.
# .env is gitignored. .env.example is committed.

# --- Master key for the LiteLLM proxy itself ---
# This is what agents use to talk to LiteLLM. It is NOT a provider key.
# Generate a strong random value:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-master-CHANGE-ME

# --- Base URL the isolated LiteLLM process dials for upstream calls ---
# In the POC fallback, this points at the egress proxy.
# In production with microsandbox, this would point at the real provider
# and microsandbox's egress layer would intercept and rewrite.
# The :8082 port is the egress proxy. The proxy enforces the allowlist
# and substitutes the real key.
FAKE_PROVIDER_API_BASE=http://127.0.0.1:8082/v1

# --- Dummy key INSIDE the LiteLLM microVM/proxy ---
# The LiteLLM process ONLY ever sees this value as the "real" key.
# The egress boundary rewrites it to FAKE_PROVIDER_REAL_KEY only when the
# destination is in the allowlist.
FAKE_PROVIDER_DUMMY_KEY=dummy-key-injected-at-egress

# --- Real key (host-side only, NEVER passed to LiteLLM) ---
# The egress proxy reads this from the host's environment and substitutes
# it on the way out. The LiteLLM process never sees this value.
FAKE_PROVIDER_REAL_KEY=sk-real-secret-key-DO-NOT-LEAK-CHANGE-ME
