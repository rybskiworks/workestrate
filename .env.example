# ai-workbench environment schema.
# This file is committed and safe to share.
# Real secrets live in .env.enc (encrypted) and are loaded by workestrate at runtime.

# LiteLLM proxy authentication. Agents use this in milestone 1.
LITELLM_MASTER_KEY=

# Provider keys used by LiteLLM only. Agents never receive these.
OPENROUTER_API_KEY=
KIMI_CODE_API_KEY=
# Neuralwatt provider key used by LiteLLM only.
NEURALWATT_API_KEY=
# MiniMax Coding provider key used by LiteLLM only.
MINIMAX_CODING_API_KEY=

# GitHub Personal Access Token for agent sandboxes (git operations + API).
GITHUB_TOKEN=

# Odysseus admin login password (AUTH_ENABLED is on by default).
ODYSSEUS_ADMIN_PASSWORD=

# Optional local paths
AI_WORKBENCH_WORKSPACES_DIR=workspaces
AI_WORKBENCH_VAR_DIR=var
