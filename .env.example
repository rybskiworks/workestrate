# ai-workbench local environment template.
# Copy to .env locally. Do not commit real secrets.

# LiteLLM auth
LITELLM_MASTER_KEY=sk-change-me-local-only

# Provider keys used by LiteLLM only.
# Do not pass these to Pi/Odysseus sandboxes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Dummy keys for agent sandboxes (LiteLLM-facing only)
OPENAI_DUMMY_KEY=sk-litellm-dummy-openai
ANTHROPIC_DUMMY_KEY=sk-litellm-dummy-anthropic

# Optional local paths
AI_WORKBENCH_WORKSPACES_DIR=workspaces
AI_WORKBENCH_VAR_DIR=var
