# ai-workbench environment schema.
# This file is committed and safe to share.
# Real secrets live in .env.enc (encrypted) or are injected via with-secrets.

# LiteLLM proxy authentication. Agents use this in milestone 1.
LITELLM_MASTER_KEY=sk-change-me-local-only

# Provider keys used by LiteLLM only. Agents never receive these.
OPENROUTER_API_KEY=
KIMI_CODE_API_KEY=
MINIMAX_CODING_API_KEY=
INCEPTION_API_KEY=

# Optional local paths
AI_WORKBENCH_WORKSPACES_DIR=workspaces
AI_WORKBENCH_VAR_DIR=var
