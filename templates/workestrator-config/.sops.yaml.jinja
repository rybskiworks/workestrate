{% if team_age_recipient %}
# SOPS config for {{ config_name }} config repo.
# Age recipients: personal + team.
# Generate your age key:
#   age-keygen -o ~/.config/sops/age/ai-workbench-secrets.txt
# Get your public key:
#   age-keygen -y ~/.config/sops/age/ai-workbench-secrets.txt

keys:
  - &{{ config_name }} {{ age_recipient }}
  - &team {{ team_age_recipient }}
creation_rules:
  # Shared secrets: encrypted to both personal + team
  - path_regex: ^secrets/shared/.*\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
          - *team
  # Personal-only secrets: encrypted to personal key only
  - path_regex: ^secrets/{{ config_name }}/.*\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
  # Default .env.enc: encrypted to both personal + team
  - path_regex: ^\.env\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
          - *team
{% else %}
# SOPS config for {{ config_name }} config repo.
# Age recipient: personal key.
# Generate your age key:
#   age-keygen -o ~/.config/sops/age/ai-workbench-secrets.txt
# Get your public key:
#   age-keygen -y ~/.config/sops/age/ai-workbench-secrets.txt

keys:
  - &{{ config_name }} {{ age_recipient }}
creation_rules:
  # Personal-only secrets: encrypted to personal key.
  - path_regex: ^secrets/shared/.*\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
  - path_regex: ^secrets/{{ config_name }}/.*\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
  - path_regex: ^\.env\.enc$
    key_groups:
      - age:
          - *{{ config_name }}
{% endif %}
