# ai-workbench environment schema.
# This file is committed and safe to share.
# Real secrets live in .env.enc (encrypted) and are loaded by workestrate at runtime.
# This file is auto-generated by `workestrate generate-env-example`.
#
# How these values reach a workload (spec 16):
#   - env bindings default to the PLACEHOLDER (least exposure); the real value
#     is substituted by the egress rewrite only for hosts in `allowed_hosts`.
#   - the real value in-sandbox is an explicit `bound = "guest"` opt-in,
#     reserved for workloads that verify the credential (e.g. litellm itself).
#   - `secret` appears at a binding only when RENAMING (env name != secret ID);
#     same-name bindings are just `KEY = true`.
GITHUB_TOKEN=
KIMI_CODE_API_KEY=
LITELLM_MASTER_KEY=
MINIMAX_CODING_API_KEY=
NEURALWATT_API_KEY=
ODYSSEUS_ADMIN_PASSWORD=
OPENROUTER_API_KEY=

# Optional local paths
AI_WORKBENCH_WORKSPACES_DIR=workspaces
AI_WORKBENCH_VAR_DIR=var
