#:schema ./schemas/workestrate.schema.json

schema_version = 1

# workestrate fleet: {{ config_name }}
# Generated by `workestrate fleet new`.
# Edit this file to define your workloads, secrets, and overrides.

# ─── Secret definitions ────────────────────────────────────────────────────
# These define the schema for your encrypted secrets (.env.enc) — a pure
# catalog of each credential's intrinsic properties. `allowed_hosts` entries
# must come from the core egress allowlist (policy/network_policy.rs);
# there is no core per-secret table — any secret you declare may bind
# allowlisted hosts.
#
# A definition says NOTHING about how any workload sees the value. Exposure
# is declared per workload, at the env binding site:
#   - bindings default to the PLACEHOLDER (least exposure): the workload sees
#     a known-bad value; the real value is substituted by the egress rewrite
#     only for hosts in `allowed_hosts` (omitted = deny-all).
#   - the real value in-sandbox is an explicit `bound = "guest"` opt-in on
#     the binding, reserved for workloads that VERIFY the credential (e.g.
#     a proxy service verifying its callers).

# Generic example secrets — replace with your own credentials.
# `on_violation` (per secret) picks what happens when the $MSB_<NAME>
# placeholder reaches a NON-allowed host: "passthrough" (the default) lets
# the harmless placeholder text through — the real value is still substituted
# only for `allowed_hosts`.
[secrets.EXAMPLE_API_KEY]
env_var = "EXAMPLE_API_KEY"
required = false

[secrets.GITHUB_TOKEN]
env_var = "GITHUB_TOKEN"
allowed_hosts = ["github.com", "api.github.com"]
required = false
# on_violation = "passthrough"   # default; also: block, block-and-log, block-and-terminate

# ─── Secret violation policy (optional) ────────────────────────────────────
# [policy.secrets] sets a DEFAULT on_violation for every secret, resolved
# through a ladder (later = more specific wins):
#   built-in passthrough
#     < config registry config.toml [policy.secrets]   (operator scope)
#     < this file's [policy.secrets]
#     < [workloads.<name>.policy.secrets]
#     < per-secret [secrets.<NAME>] on_violation
# `final = true` freezes the value so lower rungs cannot override it.
# [policy.secrets]
# on_violation = "block-and-log"
# final = true

# ─── Workload definitions ──────────────────────────────────────────────────
# Add [workloads.<name>] tables here. See:
# https://github.com/georgrybski/ai-workbench/blob/main/docs/migration/20-target-system-spec.md
#
# Example minimal agent workload. Env map value forms (spec 16):
#   KEY = "value"                        literal
#   KEY = true                           host-bound placeholder for secret KEY
#                                        (the default, least-exposure posture —
#                                        the egress rewrite substitutes the real
#                                        value only for `allowed_hosts`)
#   KEY = { secret = "ID" }              same, but RENAMED (env name != secret
#                                        ID); `secret` is written ONLY when
#                                        renaming
#   KEY = { bound = "guest" }            the REAL value in-sandbox — the explicit
#                                        opt-in, reserved for workloads that
#                                        verify the credential
# [workloads.my-agent]
# kind = "agent"
# image = { recipe = "registry", ref = "node:24-bookworm-slim" }
# workdir = "/work"
# cpus = 2
# memory_mib = 2048
# command = ["my-agent"]
# log_stop_errors = false
#
# [workloads.my-agent.env]
# MY_FLAG = "1"
# GITHUB_TOKEN = true                    # placeholder; agent never sees the real token
# # GITHUB_TOKEN = { bound = "guest" }   # only if my-agent VERIFIES the token itself
#
# [[workloads.my-agent.mounts]]
# host = "${CWD}"
# guest = "/work"
# mode = "rw"    # "ro" for read-only; `read_only = <bool>` is a deprecated alias
#
# [workloads.my-agent.network.defaults]
# egress = "deny"
# ingress = "deny"  # absent = deny; explicit "allow" stands alone
#
# [[workloads.my-agent.policy.egress.allow.host]]
# ports = [53]
# protocols = ["tcp", "udp"]
# final = false
#
# [[workloads.my-agent.policy.egress.allow.host]]
# ports = [4000]
# protocols = ["tcp"]
# final = false
#
# [[workloads.my-agent.policy.egress.allow.domain]]
# domains = ["github.com", "api.github.com"]
# port = 443
# protocol = "tcp"
# final = false
#
# [[workloads.my-agent.policy.egress.deny.domain]]
# domains = [".example.com"]
# final = false
#
# [[workloads.my-agent.policy.ingress.allow.port]]
# ports = [8080]
# protocol = "tcp"
# scope = "local"
# final = false
#
# Nested virtualization (ADR 0036; COMMENTED — absent table = off, current
# behavior): require fails closed at up without host nested KVM, prefer
# degrades machine-readably, off ignores. Home [policy.virtualization]
# (allow_nested + final) seals.
# [workloads.my-agent.virtualization]
# nested = "require"  # "require" | "prefer" | "off"; default "off"
# # [policy.virtualization]  # config-registry operator seal (restrict-only)
# # allow_nested = true
# # final = false

# ─── Mount policy (spec 22) ────────────────────────────────────────────────
# Optional [policy.mounts] block (global) and per-mount `policy = { ... }`
# entries. See spec 22 for the full read/write deny/allow + final vocabulary.
# [policy.mounts.read]
# deny = ["**/.env", "**/.ssh/**"]
# allow = ["**/.env.example"]
# # protection = operator scopes only: a final read.deny in the config registry
# # or overrides.toml compiles to the protect bucket (hidden AND untouchable)
# [policy.mounts.write]
# allow = ["**/.tmp/**"]
# deny = ["**/.secret/**"]
